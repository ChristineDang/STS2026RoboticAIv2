# Copy to .env and fill in. Only VITE_ variables reach the browser.

# ---- Live feed (dashboard) -------------------------------------------------
# "relay": listen to the local webhook relay (npm run relay). Default.
# "websocket": connect to WebSocket(s) hosted by the backend instead.
VITE_FEED_MODE=relay
VITE_RELAY_URL=http://localhost:8787
# Must match RELAY_VIEW_KEY below if you set one.
# VITE_RELAY_VIEW_KEY=

# websocket mode only
VITE_BACKEND_PROTOCOL=http
VITE_BACKEND_HOST=localhost
VITE_BACKEND_PORT=8000
# Comma-separated socket paths. Add /ws/events if the backend adds a separate events feed.
VITE_WS_PATHS=/ws/stats

# ---- Robot camera ----------------------------------------------------------
# MJPEG stream URL from the robot, e.g. http://192.168.1.50:8080/video_feed
# The dashboard laptop must be able to reach it. Don't put a password in this
# URL: VITE_ values are readable by anyone who opens the dashboard.
VITE_CAMERA_URL=

# ---- Alerts and Iris -------------------------------------------------------
# false removes Iris entirely (alerts, red edges and hidden data still work).
VITE_IRIS_ENABLED=true
# true if the hardware reports back (arm closing/closed/failed). Then no report
# within VITE_ARM_TIMEOUT_MS marks the alert as "arm didn't respond".
VITE_ARM_FEEDBACK=false
VITE_ARM_TIMEOUT_MS=15000

# ---- System health thresholds (milliseconds) -------------------------------
# No webhook for this long shows "Quiet".
VITE_WEBHOOK_QUIET_MS=120000
# A robot arm report older than this shows "No recent report".
VITE_ROBOT_STALE_MS=30000
# Robot latency above this shows "Slow".
VITE_ROBOT_SLOW_MS=500
# Camera frame rate below this shows "Low frame rate" (frames per second, not ms).
VITE_CAMERA_MIN_FPS=5

# ---- Relay (read by relay/server.mjs only, never sent to the browser) ------
RELAY_PORT=8787
# REQUIRED: a long random string, shared with the backend team.
RELAY_SECRET=
RELAY_ALLOWED_ORIGINS=http://localhost:5173
# Optional: only accept webhooks from these IPs (comma-separated).
# RELAY_ALLOWED_IPS=
# Optional: require ?key= on the dashboard stream and photos (set VITE_RELAY_VIEW_KEY to match).
# Without it, photos of denied people can only be viewed from this computer.
# RELAY_VIEW_KEY=

# ---- Photos of denied people (relay) ---------------------------------------
# "off" stops saving photos.
RELAY_CAPTURES=on
# Where to grab a frame if the backend doesn't send an image. Defaults to VITE_CAMERA_URL.
# RELAY_CAMERA_URL=
# Delete photos older than this many days (0 = keep until deleted by hand).
RELAY_CAPTURE_RETENTION_DAYS=30
# Minimum time between two photos.
RELAY_CAPTURE_COOLDOWN_MS=30000
# Database folder (default relay/data, which git ignores).
# RELAY_CAPTURE_DIR=

# ---- Camera health (relay) -------------------------------------------------
# The relay keeps one connection to the camera to measure frame rate and uptime.
# "off" if the camera only allows one viewer (the dashboard's live feed needs it).
RELAY_CAMERA_MONITOR=on
